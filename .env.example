# Copy to .env and fill in the secrets. Values below work with docker-compose dev infra.

# Database
DATABASE_URL=postgresql+asyncpg://cr:cr_dev@localhost:5432/concertradar
DATABASE_URL_SYNC=postgresql://cr:cr_dev@localhost:5432/concertradar

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=concert-radar

# Ticketmaster
TICKETMASTER_API_KEY=<your key from developer.ticketmaster.com>
TICKETMASTER_DMA_ID=249

# Spotify
SPOTIFY_CLIENT_ID=<your Spotify app client ID>
SPOTIFY_CLIENT_SECRET=<your Spotify app client secret>
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# Auth
JWT_SECRET=dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Mapbox (frontend)
NEXT_PUBLIC_MAPBOX_TOKEN=<your Mapbox public token>
