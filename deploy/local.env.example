# Values for a local rehearsal with deploy/compose.local.yml. Never put real secrets here.
ECR_REGISTRY=local
IMAGE_TAG=dev
PUBLIC_HOST=localhost
POSTGRES_PASSWORD=local-rehearsal
JWT_SECRET=local-rehearsal-jwt-secret
# bcrypt hash of the password "admin" (caddy hash-password); single quotes keep each $ literal.
JAEGER_PASSWORD_HASH='$2a$14$X4hzY7lYBt.izmLF/tLxx.arCnj0cZd8DrUsrQpoC585GvuCiZAiO'
# The scraper job needs a real key to scrape; the stack itself runs without one.
TICKETMASTER_API_KEY=unused-locally
RAW_BUCKET=
# Redpanda's external listener; on AWS this is the host's private IP (deploy.sh reads it).
HOST_PRIVATE_IP=redpanda
